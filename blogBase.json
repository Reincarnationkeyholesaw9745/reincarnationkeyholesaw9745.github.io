aw.githubusercontent.com/tghaocc/tghaocc.github.io/refs/heads/main/IMG_4794.png\"}},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"\u82f9\u679c\u5171\u4eabID\u53ef\u4ee5\u5728\u8bbe\u7f6e\uff08iCloud\uff09\u4e2d\u767b\u5f55\u5417\uff1f\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\u7edd\u5bf9\u4e0d\u80fd\uff01\u5171\u4eab\u8d26\u53f7\u7edd\u5bf9\u7981\u6b62\u5728 iPhone \u7684\u3010\u8bbe\u7f6e-iCloud\u3011\u4e2d\u767b\u5f55\uff0c\u5426\u5219\u53ef\u80fd\u5bfc\u81f4\u624b\u673a\u9501\u5b9a\u3002\u8bf7\u4ec5\u5728\u3010App Store\u3011\u4e2d\u767b\u5f55\u4e0b\u8f7d\u5e94\u7528\u3002\"}},{\"@type\":\"Question\",\"name\":\"\u767b\u5f55\u5171\u4eab Apple ID \u63d0\u793a\u53cc\u91cd\u8ba4\u8bc1\uff082FA\uff09\u9a8c\u8bc1\u7801\u600e\u4e48\u529e\uff1f\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\u79d1\u6280\u5c9b (kjdid.com) \u63d0\u4f9b\u5b9e\u65f6 2FA \u9a8c\u8bc1\u7801\u83b7\u53d6\u652f\u6301\uff0c\u67e5\u770b\u5bf9\u5e94\u8d26\u53f7\u6587\u7ae0\u9875\u9762\u5373\u53ef\u83b7\u53d6\u6700\u65b0 6 \u4f4d\u6570\u9a8c\u8bc1\u7801\u3002\"}},{\"@type\":\"Question\",\"name\":\"\u5982\u4f55\u514d\u8d39\u4e0b\u8f7d\u5c0f\u706b\u7bad\uff08Shadowrocket\uff09\uff1f\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\u4f7f\u7528\u79d1\u6280\u5c9b (kjdid.com) \u63d0\u4f9b\u7684\u5df2\u8d2d\u5c0f\u706b\u7bad\uff08Shadowrocket\uff09\u7f8e\u533a\u6216\u6e2f\u533a\u5171\u4eab Apple ID\uff0c\u767b\u5f55 App Store \u540e\u5728\u5df2\u8d2d\u9879\u76ee\uff08Purchased\uff09\u4e2d\u5373\u53ef\u514d\u8d39\u4e0b\u8f7d\u3002\"}}]}]}</script>\n<style>\n/* \ud83c\udf1f 1. Header \u9876\u90e8\u5bfc\u822a\u680f\u9ad8\u7ea7\u5f39\u6027\u7f51\u683c\u5e03\u5c40 */\n#header, .subnav {\n    display: flex !important;\n    flex-wrap: wrap !important;\n    align-items: center !important;\n    justify-content: space-between !important;\n    width: 100% !important;\n    position: relative !important;\n    padding-bottom: 12px !important;\n    border-bottom: 1px solid var(--color-border-muted, rgba(140, 149, 159, 0.2)) !important;\n    gap: 10px 0 !important;\n}\n\n.title-right, .subnav-right {\n    display: flex !important;\n    align-items: center !important;\n    justify-content: flex-end !important;\n    gap: 8px !important;\n    margin: 0 !important;\n}\n\n/* \ud83c\udf1f 2. \u53f3\u4e0a\u89d2\u529f\u80fd\u6309\u94ae\u786c\u4ef6\u52a0\u901f\u4e0e\u7cbe\u7ec6\u7f8e\u5316 */\n#buttonHome, #buttonSearch, #buttonTheme, a.btn-invisible.circle {\n    display: inline-flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    width: 36px !important;\n    height: 36px !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    border: 1px solid rgba(167, 139, 250, 0.3) !important;\n    background: rgba(124, 58, 237, 0.08) !important;\n    border-radius: 50% !important;\n    backdrop-filter: blur(8px) !important;\n    -webkit-backdrop-filter: blur(8px) !important;\n    box-sizing: border-box !important;\n    transition: all 0.2s ease !important;\n}\n\n#buttonHome:hover, #buttonSearch:hover, #buttonTheme:hover {\n    background: rgba(124, 58, 237, 0.18) !important;\n    border-color: rgba(167, 139, 250, 0.6) !important;\n}\n\n#buttonHome svg, #buttonTheme svg, #buttonSearch svg, a.btn-invisible svg {\n    width: 18px !important;\n    height: 18px !important;\n    fill: #a78bfa !important;\n    margin: 0 !important;\n}\n\n/* \ud83c\udf1f 3. \u5de6\u4e0a\u89d2\u54c1\u724c\u9ad8\u7ea7\u80f6\u56ca\u5361\u7247 */\n.pro-brand-capsule {\n    display: inline-flex !important;\n    align-items: center;\n    padding: 4px 14px 4px 6px !important;\n    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(243, 232, 255, 0.9) 100%) !important;\n    border: 1px solid rgba(167, 139, 250, 0.5) !important;\n    border-radius: 30px !important;\n    box-shadow: 0 4px 14px rgba(124, 58, 237, 0.12) !important;\n    text-decoration: none !important;\n    height: 36px !important;\n    box-sizing: border-box !important;\n    will-change: transform;\n}\n\n[data-color-mode=\"dark\"] .pro-brand-capsule {\n    background: linear-gradient(135deg, rgba(30, 27, 75, 0.85) 0%, rgba(49, 46, 129, 0.75) 100%) !important;\n    border-color: rgba(167, 139, 250, 0.35) !important;\n}\n\n.pro-brand-capsule img, .pro-brand-capsule .avatar {\n    width: 26px !important;\n    height: 26px !important;\n    border-radius: 50% !important;\n    object-fit: cover;\n    margin-right: 8px !important;\n}\n\n.pro-brand-text {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    line-height: 1.1;\n}\n\nh1.pro-brand-title, .pro-brand-title {\n    font-size: 14px !important;\n    font-weight: 800 !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    line-height: 1 !important;\n    background: linear-gradient(135deg, #7c3aed 0%, #2563eb 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n}\n\n.pro-brand-subtitle {\n    font-size: 7.5px !important;\n    font-weight: 700 !important;\n    color: #6b7280 !important;\n    letter-spacing: 1px;\n}\n\n/* \ud83c\udf1f 4. \u5168\u5bbd\u6c89\u6d78\u5f0f\u641c\u7d22\u680f */\n.subnav-search, div[search] {\n    flex: 0 0 100% !important;\n    width: 100% !important;\n    max-width: 100% !important;\n    height: 42px !important;\n    margin: 4px 0 0 0 !important;\n    padding: 0 4px 0 14px !important;\n    background: rgba(255, 255, 255, 0.85) !important;\n    backdrop-filter: blur(12px) !important;\n    -webkit-backdrop-filter: blur(12px) !important;\n    border: 1.5px solid rgba(167, 139, 250, 0.4) !important;\n    border-radius: 21px !important;\n    box-shadow: 0 4px 16px rgba(124, 58, 237, 0.08) !important;\n    box-sizing: border-box !important;\n    display: flex !important;\n    align-items: center !important;\n    justify-content: space-between !important;\n}\n\n[data-color-mode=\"dark\"] .subnav-search, \n[data-color-mode=\"dark\"] div[search] {\n    background: rgba(22, 20, 52, 0.85) !important;\n    border-color: rgba(167, 139, 250, 0.25) !important;\n}\n\n.subnav-search input, div[search] input {\n    flex: 1 !important;\n    background: transparent !important;\n    border: none !important;\n    outline: none !important;\n    color: var(--color-fg-default) !important;\n    font-size: 14px !important;\n}\n\n.subnav-search button, div[search] button {\n    height: 32px !important;\n    padding: 0 16px !important;\n    background: linear-gradient(135deg, #7c3aed, #4f46e5) !important;\n    color: #ffffff !important;\n    border: none !important;\n    border-radius: 16px !important;\n    font-size: 13px !important;\n    font-weight: 700 !important;\n    cursor: pointer !important;\n}\n\n/* \ud83c\udf1f 5. \u7cfb\u7edf\u516c\u544a\u5361\u7247 */\n.pro-notice-card {\n    width: 100% !important;\n    box-sizing: border-box !important;\n    background: linear-gradient(135deg, #2e1065 0%, #1e1b4b 50%, #0f172a 100%) !important;\n    border: 1px solid rgba(167, 139, 250, 0.3) !important;\n    border-radius: 14px !important;\n    padding: 12px 14px !important;\n    margin: 12px 0 16px 0 !important;\n    color: #f1f5f9 !important;\n    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.25) !important;\n}\n.pro-notice-header { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }\n.pro-notice-badge1 { background: linear-gradient(135deg, #7c3aed, #4f46e5); color: #fff; font-size: 10.5px; font-weight: 700; padding: 2px 8px; border-radius: 5px; }\n.pro-notice-badge2 { background: rgba(255, 255, 255, 0.1); color: #c084fc; font-size: 10.5px; font-weight: 600; padding: 2px 7px; border-radius: 5px; }\n.pro-notice-body { font-size: 12.5px !important; line-height: 1.65 !important; color: #cbd5e1 !important; }\n\n/* \ud83c\udf1f 6. \u524d\u53f0\u5f7b\u5e95\u6c89\u6d78\u5f0f\u62b9\u53bb\u9ed8\u8ba4\u526f\u6807\u9898\u75d5\u8ff9 */\n#subTitle, .subTitle, #subtitle, .subtitle, .sub-title, #sub-title, .site-subtitle, .header-subtitle, .tagTitle {\n    display: none !important;\n    height: 0 !important;\n    width: 0 !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    opacity: 0 !important;\n    visibility: hidden !important;\n    pointer-events: none !important;\n    overflow: hidden !important;\n}\n</style>\n\n<script>\n(function() {\n    if (window.__PRO_THEME_OPTIMIZED__) return;\n    window.__PRO_THEME_OPTIMIZED__ = true;\n\n    // \u6781\u81f4\u6e05\u7406\u51fd\u6570\uff1a\u5f7b\u5e95\u79fb\u9664\u9875\u9762\u4e2d\u53ef\u80fd\u6b8b\u7559\u7684\u9ed8\u8ba4\u526f\u6807\u9898\u5143\u7d20\n    function purgeSubtitles() {\n        const selectors = '#subTitle, .subTitle, #subtitle, .subtitle, .sub-title, #sub-title, .site-subtitle, .header-subtitle';\n        document.querySelectorAll(selectors).forEach(el => el.remove());\n    }\n\n    function initProTheme() {\n        purgeSubtitles();\n        \n        const headerContainer = document.getElementById(\"header\") || document.querySelector(\".subnav\");\n        if (!headerContainer) return;\n\n        // \u4f18\u5316\u641c\u7d22\u6846\u7ed3\u6784\u5f52\u4f4d\n        const searchBox = document.querySelector(\".subnav-search\") || document.querySelector(\"div[search]\");\n        if (searchBox && searchBox.parentNode !== headerContainer) {\n            headerContainer.appendChild(searchBox);\n        }\n\n        // \u6ce8\u5165\u54c1\u724c\u80f6\u56ca\u7ec4\u4ef6\n        if (!document.getElementById(\"proBrandCapsule\")) {\n            const capsule = document.createElement(\"a\");\n            capsule.id = \"proBrandCapsule\";\n            capsule.href = \"https://kjdid.com\";\n            capsule.className = \"pro-brand-capsule\";\n            capsule.innerHTML = '<img src=\"https://raw.githubusercontent.com/tghaocc/tghaocc.github.io/refs/heads/main/IMG_4794.png\" class=\"avatar\" alt=\"\u79d1\u6280\u5c9b\u56fe\u6807\"><div class=\"pro-brand-text\"><h1 class=\"pro-brand-title\">\u79d1\u6280\u5c9b</h1><span class=\"pro-brand-subtitle\">KJDID.COM</span></div>';\n            \n            const oldAvatar = document.getElementById(\"avatarImg\") || document.querySelector(\".avatar\");\n            if (oldAvatar && oldAvatar.parentNode !== capsule) {\n                oldAvatar.remove();\n            }\n            headerContainer.insertBefore(capsule, headerContainer.firstChild);\n        }\n\n        // \u6ce8\u5165\u7cfb\u7edf\u516c\u544a\u5361\u7247\n        if (!document.getElementById(\"proNoticeCard\")) {\n            const noticeCard = document.createElement(\"div\");\n            noticeCard.id = \"proNoticeCard\";\n            noticeCard.className = \"pro-notice-card\";\n            noticeCard.innerHTML = '<div class=\"pro-notice-header\"><span class=\"pro-notice-badge1\">\ud83d\udce2 \u7cfb\u7edf\u516c\u544a</span><span class=\"pro-notice-badge2\">\u5e73\u53f0\u6307\u5357</span></div><div class=\"pro-notice-body\">\u6b22\u8fce\u6765\u5230\u79d1\u6280\u5c9b (kjdid.com)\uff01\u6211\u4eec\u957f\u671f\u4e3a\u60a8\u63d0\u4f9b\u7a33\u5b9a\u3001\u5b89\u5168\u7684\u7f8e\u533a\u4e0e\u9999\u6e2f\u82f9\u679c\u5171\u4eab ID\u3001\u5c0f\u706b\u7bad\u5171\u4eab\u8d26\u53f7\u83b7\u53d6\u6307\u5357\u3002\u5728\u8fd9\u91cc\uff0c\u60a8\u53ef\u4ee5\u8f7b\u677e\u83b7\u53d6\u5b9e\u65f6\u66f4\u65b0\u7684\u5171\u4eab\u8d26\u53f7\uff0c\u5e76\u89e3\u51b3 iOS \u9501\u533a\u3001\u53cc\u91cd\u8ba4\u8bc1\uff082FA\uff09\u53ca\u8f6f\u4ef6\u4e0b\u8f7d\u7b49\u5e38\u89c1\u95ee\u9898\uff0c\u4e00\u7ad9\u5f0f\u89e3\u9501\u5168\u7403\u7cbe\u5f69\u5e94\u7528\u4e0e\u6e38\u620f\u3002</div>';\n            \n            if (headerContainer.parentNode) {\n                headerContainer.insertAdjacentElement('afterend', noticeCard);\n            }\n        }\n        purgeSubtitles();\n    }\n\n    // \u9875\u9762\u5c31\u7eea\u540e\u7acb\u5373\u6267\u884c\uff0c\u5e76\u914d\u5408 MutationObserver \u5b9e\u65f6\u76d1\u63a7\u52a8\u6001\u8def\u7531\u8df3\u8f6c\u6e32\u67d3\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', initProTheme);\n    } else {\n        initProTheme();\n    }\n\n    // \u53cc\u91cd\u4fdd\u9669\uff1a\u5f02\u6b65\u5ef6\u65f6\u8865\u5200\u6e05\u7406\uff0c\u5e76\u76d1\u542c DOM \u53d8\u52a8\u9632\u6846\u67b6\u4e8c\u6b21\u6e32\u67d3\u6c61\u67d3\n    setTimeout(purgeSubtitles, 200);\n    setTimeout(purgeSubtitles, 800);\n\n    const observer = new MutationObserver(() => {\n        purgeSubtitles();\n    });\n    observer.observe(document.body, { childList: true, subtree: true });\n})();\n</script>", "title": "\u514d\u8d39\u7f8e\u533a\u6e2f\u533a Apple ID | \u5c0f\u706b\u7bad Shadowrocket \u5171\u4eab\u8d26\u53f7 - \u79d1\u6280\u5c9b", "subTitle": "\u79d1\u6280\u5c9b (kjdid.com) \u662f\u4e13\u4e1a\u53ef\u9760\u7684\u82f9\u679c\u5e94\u7528\u5206\u53d1\u4e0e\u8de8\u533a\u6307\u5357\u5e73\u53f0\uff0c\u957f\u671f\u514d\u8d39\u63d0\u4f9b\u7a33\u5b9a\u5b89\u5168\u7684\u7f8e\u533a\u3001\u6e2f\u533a Apple ID \u4e0e\u5c0f\u706b\u7bad (Shadowrocket) \u5171\u4eab\u8d26\u53f7\u3002\u5b9e\u65f6\u66f4\u65b0\u53ef\u7528\u8d26\u53f7\u4e0e 2FA \u53cc\u91cd\u8ba4\u8bc1\u9a8c\u8bc1\u7801\uff0c\u624b\u628a\u624b\u89e3\u51b3 iOS \u9501\u533a\u3001\u6d77\u5916\u5e94\u7528\u4e0b\u8f7d\u53ca\u8f6f\u4ef6\u5b89\u88c5\u96be\u9898\uff0c\u52a9\u60a8\u8f7b\u677e\u7545\u73a9\u5168\u7403\u7cbe\u54c1\u5e94\u7528\u3002", "description": "\u79d1\u6280\u5c9b (kjdid.com) \u662f\u4e13\u4e1a\u53ef\u9760\u7684\u82f9\u679c\u5e94\u7528\u5206\u53d1\u4e0e\u8de8\u533a\u6307\u5357\u5e73\u53f0\uff0c\u957f\u671f\u514d\u8d39\u63d0\u4f9b\u7a33\u5b9a\u5b89\u5168\u7684\u7f8e\u533a\u3001\u6e2f\u533a Apple ID \u4e0e\u5c0f\u706b\u7bad (Shadowrocket) \u5171\u4eab\u8d26\u53f7\u3002\u5b9e\u65f6\u66f4\u65b0\u53ef\u7528\u8d26\u53f7\u4e0e 2FA \u53cc\u91cd\u8ba4\u8bc1\u9a8c\u8bc1\u7801\uff0c\u624b\u628a\u624b\u89e3\u51b3 iOS \u9501\u533a\u3001\u6d77\u5916\u5e94\u7528\u4e0b\u8f7d\u53ca\u8f6f\u4ef6\u5b89\u88c5\u96be\u9898\uff0c\u52a9\u60a8\u8f7b\u677e\u7545\u73a9\u5168\u7403\u7cbe\