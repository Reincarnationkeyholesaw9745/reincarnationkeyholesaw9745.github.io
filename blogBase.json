{"singlePage": [], "startSite": "", "filingNum": "", "onePageListNum": 15, "commentLabelColor": "#006b75", "yearColorList": ["#bc4c00", "#0969da", "#1f883d", "#A333D0"], "i18n": "CN", "themeMode": "manual", "dayTheme": "light", "nightTheme": "dark", "urlMode": "pinyin", "script": "", "style": "", "head": "", "indexScript": "", "indexStyle": "", "bottomText": "", "showPostSource": 1, "iconList": {}, "UTC": 8, "rssSplit": "sentence", "exlink": {}, "needComment": 1, "allHead": "<link rel=\"canonical\" href=\"https://tghaocc.github.io/\">\n<meta name=\"robots\" content=\"index, follow\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"\u79d1\u6280\u5c9b - \u514d\u8d39\u82f9\u679cID\u5171\u4eab_\u7f8e\u533a\u65e5\u533aAppleID\u4e0e\u5c0f\u706b\u7bad\u8d26\u53f7\u83b7\u53d6\">\n<meta property=\"og:description\" content=\"\u79d1\u6280\u5c9b\u662f\u4e13\u4e1a\u76842026\u514d\u8d39\u82f9\u679cID\u5171\u4eab\u4e0e\u6d77\u5916AppleID\u83b7\u53d6\u5e73\u53f0\u3002\u6bcf\u65e5\u5b9e\u65f6\u66f4\u65b0\u7a33\u5b9a\u53ef\u7528\u7684\u7f8e\u533a\u3001\u65e5\u533a\u3001\u6e2f\u533a\u82f9\u679c\u8d26\u53f7\u53ca\u5bc6\u7801\uff0c\u4e00\u7ad9\u5f0f\u89e3\u51b3App Store\u9501\u533a\u3001\u53cc\u91cd\u8ba4\u8bc1\uff082FA\uff09\u53caShadowrocket\uff08\u5c0f\u706b\u7bad\uff09\u4e0b\u8f7d\u96be\u9898\u3002\">\n<meta property=\"og:url\" content=\"https://tghaocc.github.io/\">\n<style>\n/* \ud83c\udf1f 1. Header \u5bfc\u822a\u680f\uff1a\u5f00\u542f\u5f39\u6027\u6362\u884c */\n#header {\n    position: relative !important;\n    width: 100% !important;\n}\n\n.subnav {\n    display: flex !important;\n    flex-wrap: wrap !important; /* \u5141\u8bb8\u5c55\u5f00\u65f6\u6362\u884c\u5360\u6ee1\u4e00\u6574\u884c */\n    align-items: center !important;\n    justify-content: space-between !important;\n    width: 100% !important;\n    gap: 8px 0 !important;\n}\n\n/* \ud83c\udf1f 2. \u53f3\u4fa7\u529f\u80fd\u6309\u94ae\u5bf9\u9f50 */\n.subnav-right {\n    display: flex !important;\n    align-items: center !important;\n    gap: 8px !important;\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n#buttonSearch, #buttonTheme, a.btn-invisible {\n    display: inline-flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    width: 34px !important;\n    height: 34px !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    border: none !important;\n    background: none !important;\n    border-radius: 50% !important;\n    vertical-align: middle !important;\n    box-sizing: border-box !important;\n}\n\n#buttonSearch svg, #buttonTheme svg {\n    width: 20px !important;\n    height: 20px !important;\n    fill: currentColor !important;\n    margin: 0 !important;\n    display: block !important;\n}\n\n/* \ud83c\udf1f 3. \u4eff Safari / Chrome \u79fb\u52a8\u6d4f\u89c8\u5668\u5168\u5bbd\u641c\u7d22\u680f\uff08100% \u5c45\u4e2d + \u653e\u5927\u955c\u5c45\u5de6\uff09 */\n.subnav-search, div[search] {\n    flex-basis: 100% !important; /* \u5f3a\u884c\u5728\u4e0b\u4e00\u884c\u5360\u6ee1 100% \u5bbd\u5ea6 */\n    width: 100% !important;\n    max-width: 100% !important;\n    height: 44px !important;\n    margin: 8px 0 4px 0 !important;\n    padding: 0 5px 0 14px !important;\n    background: rgba(30, 27, 75, 0.85) !important;\n    backdrop-filter: blur(12px) !important;\n    -webkit-backdrop-filter: blur(12px) !important;\n    border: 1.5px solid rgba(167, 139, 250, 0.4) !important;\n    border-radius: 22px !important; /* \u7ecf\u5178\u624b\u673a\u6d4f\u89c8\u5668\u5730\u5740\u680f\u5927\u5706\u89d2 */\n    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3) !important;\n    box-sizing: border-box !important;\n    display: flex !important;\n    align-items: center !important;\n    order: 99 !important; /* \u786e\u4fdd\u6392\u5728\u7b2c\u4e00\u884c\u4e0b\u65b9 */\n}\n\n/* \u641c\u7d22\u8868\u5355\u5f39\u6027\u5bf9\u9f50 */\ndiv[search] form, .subnav-search form {\n    display: flex !important;\n    align-items: center !important;\n    width: 100% !important;\n    height: 100% !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    gap: 10px !important;\n}\n\n/* \u641c\u7d22\u6846\u5185\u539f\u6709\u653e\u5927\u955c\u56fe\u6807\uff1a\u7f6e\u5de6\u5782\u76f4\u5c45\u4e2d */\ndiv[search] svg, .subnav-search svg {\n    width: 18px !important;\n    height: 18px !important;\n    fill: #a78bfa !important;\n    flex-shrink: 0 !important;\n    margin: 0 !important;\n}\n\n/* \u8f93\u5165\u6846\u6587\u672c\u6837\u5f0f */\ndiv[search] input, .subnav-search input {\n    flex: 1 !important;\n    height: 100% !important;\n    background: transparent !important;\n    border: none !important;\n    outline: none !important;\n    color: #ffffff !important;\n    font-size: 14px !important;\n    font-weight: 500 !important;\n    padding: 0 !important;\n    margin: 0 !important;\n}\n\ndiv[search] input::placeholder, .subnav-search input::placeholder {\n    color: #94a3b8 !important;\n}\n\n/* \u53f3\u4fa7\u9ad8\u4eae\u641c\u7d22\u6309\u94ae */\ndiv[search] button, .subnav-search button, div[search] .btn, .subnav-search .btn {\n    height: 34px !important;\n    padding: 0 16px !important;\n    background: linear-gradient(135deg, #7c3aed, #4f46e5) !important;\n    color: #ffffff !important;\n    border: none !important;\n    border-radius: 17px !important;\n    font-size: 13px !important;\n    font-weight: 700 !important;\n    cursor: pointer !important;\n    white-space: nowrap !important;\n    box-shadow: 0 2px 8px rgba(124, 58, 237, 0.4) !important;\n    flex-shrink: 0 !important;\n}\n\n/* \ud83c\udf1f 4. \u5de6\u4e0a\u89d2\u54c1\u724c\u80f6\u56ca\u5361\u7247 */\n.pro-brand-capsule {\n    position: relative;\n    overflow: hidden;\n    display: inline-flex !important;\n    align-items: center;\n    padding: 5px 12px !important;\n    background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(246, 240, 255, 0.95) 100%) !important;\n    border: 1.5px solid rgba(147, 112, 219, 0.45) !important;\n    border-radius: 30px !important;\n    box-shadow: 0 6px 20px rgba(138, 43, 226, 0.12) !important;\n    text-decoration: none !important;\n}\n\n.pro-brand-capsule img, .pro-brand-capsule .avatar {\n    width: 34px !important;\n    height: 34px !important;\n    border-radius: 8px !important;\n    object-fit: cover;\n    margin-right: 8px !important;\n}\n\n.pro-brand-text {\n    display: flex;\n    flex-direction: column;\n    line-height: 1.15;\n}\n\n.pro-brand-title {\n    font-size: 15px !important;\n    font-weight: 800 !important;\n    background: linear-gradient(135deg, #7b2cbf 0%, #3a86ff 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n}\n\n.pro-brand-subtitle {\n    font-size: 8px !important;\n    font-weight: 700 !important;\n    color: #6c757d !important;\n    letter-spacing: 1.2px;\n}\n\n/* \ud83c\udf1f 5. \u7cfb\u7edf\u516c\u544a\u5361\u7247 */\n.pro-notice-card {\n    position: relative !important;\n    overflow: hidden !important;\n    display: block !important;\n    width: 100% !important;\n    box-sizing: border-box !important;\n    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #151c2f 100%) !important;\n    border: 1.5px solid rgba(167, 139, 250, 0.4) !important;\n    border-radius: 16px !important;\n    padding: 14px 16px !important;\n    margin: 14px 0 18px 0 !important;\n    box-shadow: 0 10px 30px rgba(30, 27, 75, 0.3) !important;\n    color: #f1f5f9 !important;\n}\n\n.pro-notice-header {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin-bottom: 8px;\n}\n\n.pro-notice-badge1 {\n    background: linear-gradient(135deg, #7c3aed, #4f46e5);\n    color: #fff;\n    font-size: 11px;\n    font-weight: 700;\n    padding: 3px 9px;\n    border-radius: 6px;\n}\n\n.pro-notice-badge2 {\n    background: rgba(255, 255, 255, 0.12);\n    color: #c084fc;\n    font-size: 11px;\n    font-weight: 600;\n    padding: 3px 8px;\n    border-radius: 6px;\n}\n\n.pro-notice-body {\n    font-size: 13px !important;\n    line-height: 1.7 !important;\n    color: #cbd5e1 !important;\n}\n\n.subTitle {\n    display: none !important;\n}\n</style>\n\n<script>\n(function() {\n    function initProTheme() {\n        let avatarImg = document.getElementById(\"avatarImg\") || document.querySelector(\".avatar\");\n        if (avatarImg && !document.getElementById(\"proBrandCapsule\")) {\n            let capsule = document.createElement(\"a\");\n            capsule.id = \"proBrandCapsule\";\n            capsule.href = \"https://tghaocc.github.io\";\n            capsule.className = \"pro-brand-capsule\";\n            \n            let textDiv = document.createElement(\"div\");\n            textDiv.className = \"pro-brand-text\";\n            textDiv.innerHTML = '<span class=\"pro-brand-title\">\u79d1\u6280\u5c9b</span><span class=\"pro-brand-subtitle\">GLOBAL STORE</span>';\n            \n            let parent = avatarImg.parentNode;\n            if (parent) {\n                parent.insertBefore(capsule, avatarImg);\n                capsule.appendChild(avatarImg);\n                capsule.appendChild(textDiv);\n            }\n        }\n\n        if (!document.getElementById(\"proNoticeCard\")) {\n            let noticeCard = document.createElement(\"div\");\n            noticeCard.id = \"proNoticeCard\";\n            noticeCard.className = \"pro-notice-card\";\n            noticeCard.innerHTML = `\n                <div class=\"pro-notice-header\">\n                    <span class=\"pro-notice-badge1\">\ud83d\udce2 \u7cfb\u7edf\u516c\u544a</span>\n                    <span class=\"pro-notice-badge2\">\u5e73\u53f0\u6307\u5357</span>\n                </div>\n                <div class=\"pro-notice-body\">\n                    \u6b22\u8fce\u6765\u5230\u79d1\u6280\u5c9b\uff01\u6211\u4eec\u957f\u671f\u4e3a\u60a8\u63d0\u4f9b\u7a33\u5b9a\u3001\u5b89\u5168\u7684\u82f9\u679c ID \u4e0e\u6d77\u5916 Apple ID \u83b7\u53d6\u6307\u5357\u3002\u5728\u8fd9\u91cc\uff0c\u60a8\u53ef\u4ee5\u8f7b\u677e\u83b7\u53d6\u5b9e\u65f6\u66f4\u65b0\u7684\u5171\u4eab\u8d26\u53f7\uff0c\u5e76\u89e3\u51b3 iOS \u9501\u533a\u3001\u53cc\u91cd\u8ba4\u8bc1\uff082FA\uff09\u53ca\u8f6f\u4ef6\u4e0b\u8f7d\u7b49\u5e38\u89c1\u95ee\u9898\uff0c\u4e00\u7ad9\u5f0f\u89e3\u9501\u5168\u7403\u7cbe\u5f69\u5e94\u7528\u4e0e\u6e38\u620f\u3002\n                </div>\n            `;\n            \n            let headerContainer = document.getElementById(\"header\") || document.querySelector(\".header\");\n            if (headerContainer && headerContainer.parentNode) {\n                headerContainer.insertAdjacentElement('afterend', noticeCard);\n            } else {\n                document.body.prepend(noticeCard);\n            }\n        }\n    }\n\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', initProTheme);\n    } else {\n        initProTheme();\n    }\n})();\n</script>", "title": "\u79d1\u6280\u5c9b - \u514d\u8d39\u82f9\u679cID\u5171\u4eab_\u7f8e\u533a\u65e5\u533aAppleID\u4e0e\u5c0f\u706b\u7bad\u8d26\u53f7\u83b7\u53d6", "subTitle": "\u6b22\u8fce\u6765\u5230\u79d1\u6280\u5c9b\uff01", "description": "\u79d1\u6280\u5c9b\u662f\u4e13\u4e1a\u76842026\u514d\u8d39\u82f9\u679cID\u5171\u4eab\u4e0e\u6d77\u5916AppleID\u83b7\u53d6\u5e73\u53f0\u3002\u6bcf\u65e5\u5b9e\u65f6\u66f4\u65b0\u7a33\u5b9a\u53ef\u7528\u7684\u7f8e\u533a\u3001\u65e5\u533a\u3001\u6e2f\u533a\u82f9\u679c\u8d26\u53f7\u53ca\u5bc6\u7801\uff0c\u4e00\u7ad9\u5f0f\u89e3\u51b3App Store\u9501\u533a\u3001\u53cc\u91cd\u8ba4\u8bc1\uff082FA\uff09\u53caShadowrocket\uff08\u5c0f\u706b\u7bad\uff09\u4e0b\u8f7d\u96be\u9898\uff0c\u5b89\u5168\u53ef\u9760\u3002", "keywords": "\u82f9\u679cID\u5171\u4eab,\u514d\u8d39\u82f9\u679cID,\u7f8e\u533aAppleID,\u65e5\u533a\u82f9\u679c\u8d26\u53f7,\u5c0f\u706b\u7bad\u5171\u4eab,appleID\u5171\u4eab,\u82f9\u679c\u5916\u533a\u8d26\u53f7,Shadowrocket\u4e0b\u8f7d,iOS\u9501\u533a\u89e3\u51b3", "avatarUrl": "https://raw.githubusercont