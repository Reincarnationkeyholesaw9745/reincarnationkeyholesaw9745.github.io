rtant;\n    position: relative !important;\n    padding-bottom: 12px !important;\n    border-bottom: 1px solid var(--color-border-muted, rgba(140, 149, 159, 0.2)) !important;\n    gap: 10px 0 !important;\n}\n\n.title-right, .subnav-right {\n    display: flex !important;\n    align-items: center !important;\n    justify-content: flex-end !important;\n    gap: 8px !important;\n    margin: 0 !important;\n}\n\n/* \ud83c\udf1f 2. \u53f3\u4e0a\u89d2\u529f\u80fd\u6309\u94ae\uff08\u6676\u83b9\u5706\u6263\uff09 */\n#buttonHome, #buttonSearch, #buttonTheme, a.btn-invisible.circle {\n    display: inline-flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    width: 36px !important;\n    height: 36px !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    border: 1px solid rgba(167, 139, 250, 0.3) !important;\n    background: rgba(124, 58, 237, 0.08) !important;\n    border-radius: 50% !important;\n    backdrop-filter: blur(8px) !important;\n    -webkit-backdrop-filter: blur(8px) !important;\n    box-sizing: border-box !important;\n}\n\n#buttonHome svg, #buttonTheme svg, #buttonSearch svg, a.btn-invisible svg {\n    width: 18px !important;\n    height: 18px !important;\n    fill: #a78bfa !important;\n    margin: 0 !important;\n}\n\n/* \ud83c\udf1f 3. \u5de6\u4e0a\u89d2\u54c1\u724c\u80f6\u56ca\u5361\u7247 */\n.pro-brand-capsule {\n    display: inline-flex !important;\n    align-items: center;\n    padding: 4px 14px 4px 6px !important;\n    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(243, 232, 255, 0.9) 100%) !important;\n    border: 1px solid rgba(167, 139, 250, 0.5) !important;\n    border-radius: 30px !important;\n    box-shadow: 0 4px 14px rgba(124, 58, 237, 0.12) !important;\n    text-decoration: none !important;\n    height: 36px !important;\n    box-sizing: border-box !important;\n}\n\n[data-color-mode=\"dark\"] .pro-brand-capsule {\n    background: linear-gradient(135deg, rgba(30, 27, 75, 0.85) 0%, rgba(49, 46, 129, 0.75) 100%) !important;\n    border-color: rgba(167, 139, 250, 0.35) !important;\n}\n\n.pro-brand-capsule img, .pro-brand-capsule .avatar {\n    width: 26px !important;\n    height: 26px !important;\n    border-radius: 50% !important;\n    object-fit: cover;\n    margin-right: 8px !important;\n}\n\n.pro-brand-text {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    line-height: 1.1;\n}\n\n.pro-brand-title {\n    font-size: 14px !important;\n    font-weight: 800 !important;\n    background: linear-gradient(135deg, #7c3aed 0%, #2563eb 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n}\n\n.pro-brand-subtitle {\n    font-size: 7.5px !important;\n    font-weight: 700 !important;\n    color: #6b7280 !important;\n    letter-spacing: 1px;\n}\n\n/* \ud83c\udf1f 4. \u5168\u5bbd\u6c89\u6d78\u5f0f\u641c\u7d22\u680f\uff08\u72ec\u81ea\u5360\u6ee1\u7b2c 2 \u884c\uff09 */\n.subnav-search, div[search] {\n    flex: 0 0 100% !important;\n    width: 100% !important;\n    max-width: 100% !important;\n    height: 42px !important;\n    margin: 4px 0 0 0 !important;\n    padding: 0 4px 0 14px !important;\n    background: rgba(255, 255, 255, 0.85) !important;\n    backdrop-filter: blur(12px) !important;\n    border: 1.5px solid rgba(167, 139, 250, 0.4) !important;\n    border-radius: 21px !important;\n    box-shadow: 0 4px 16px rgba(124, 58, 237, 0.08) !important;\n    box-sizing: border-box !important;\n    display: flex !important;\n    align-items: center !important;\n    justify-content: space-between !important;\n}\n\n[data-color-mode=\"dark\"] .subnav-search, \n[data-color-mode=\"dark\"] div[search] {\n    background: rgba(22, 20, 52, 0.85) !important;\n}\n\n.subnav-search input, div[search] input {\n    flex: 1 !important;\n    background: transparent !important;\n    border: none !important;\n    outline: none !important;\n    color: var(--color-fg-default) !important;\n    font-size: 14px !important;\n}\n\n.subnav-search button, div[search] button {\n    height: 32px !important;\n    padding: 0 16px !important;\n    background: linear-gradient(135deg, #7c3aed, #4f46e5) !important;\n    color: #ffffff !important;\n    border: none !important;\n    border-radius: 16px !important;\n    font-size: 13px !important;\n    font-weight: 700 !important;\n}\n\n/* \ud83c\udf1f 5. \u7cfb\u7edf\u516c\u544a\u5361\u7247\u4e0e\u9690\u85cf\u9879 */\n.pro-notice-card {\n    width: 100% !important;\n    box-sizing: border-box !important;\n    background: linear-gradient(135deg, #2e1065 0%, #1e1b4b 50%, #0f172a 100%) !important;\n    border: 1px solid rgba(167, 139, 250, 0.3) !important;\n    border-radius: 14px !important;\n    padding: 12px 14px !important;\n    margin: 12px 0 16px 0 !important;\n    color: #f1f5f9 !important;\n}\n.pro-notice-header { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }\n.pro-notice-badge1 { background: linear-gradient(135deg, #7c3aed, #4f46e5); color: #fff; font-size: 10.5px; font-weight: 700; padding: 2px 8px; border-radius: 5px; }\n.pro-notice-badge2 { background: rgba(255, 255, 255, 0.1); color: #c084fc; font-size: 10.5px; font-weight: 600; padding: 2px 7px; border-radius: 5px; }\n.pro-notice-body { font-size: 12.5px !important; line-height: 1.65 !important; color: #cbd5e1 !important; }\n.tagTitle, .subTitle { display: none !important; }\n</style>\n\n<script>\n(function() {\n    if (window.__PRO_THEME_INITED__) return;\n    window.__PRO_THEME_INITED__ = true;\n\n    function initProTheme() {\n        let headerContainer = document.getElementById(\"header\") || document.querySelector(\".subnav\");\n        if (!headerContainer) return;\n\n        let searchBox = document.querySelector(\".subnav-search\") || document.querySelector(\"div[search]\");\n        if (searchBox && searchBox.parentNode !== headerContainer) {\n            headerContainer.appendChild(searchBox);\n        }\n\n        if (!document.getElementById(\"proBrandCapsule\")) {\n            let capsule = document.createElement(\"a\");\n            capsule.id = \"proBrandCapsule\";\n            capsule.href = \"https://tghaocc.github.io\";\n            capsule.className = \"pro-brand-capsule\";\n            capsule.innerHTML = '<img src=\"https://raw.githubusercontent.com/tghaocc/tghaocc.github.io/refs/heads/main/IMG_4794.png\" class=\"avatar\" alt=\"logo\"><div class=\"pro-brand-text\"><span class=\"pro-brand-title\">\u79d1\u6280\u5c9b</span><span class=\"pro-brand-subtitle\">GLOBAL STORE</span></div>';\n            \n            let oldAvatar = document.getElementById(\"avatarImg\") || document.querySelector(\".avatar\");\n            if (oldAvatar && oldAvatar.parentNode !== capsule) {\n                oldAvatar.remove();\n            }\n            headerContainer.insertBefore(capsule, headerContainer.firstChild);\n        }\n\n        if (!document.getElementById(\"proNoticeCard\")) {\n            let noticeCard = document.createElement(\"div\");\n            noticeCard.id = \"proNoticeCard\";\n            noticeCard.className = \"pro-notice-card\";\n            noticeCard.innerHTML = '<div class=\"pro-notice-header\"><span class=\"pro-notice-badge1\">\ud83d\udce2 \u7cfb\u7edf\u516c\u544a</span><span class=\"pro-notice-badge2\">\u5e73\u53f0\u6307\u5357</span></div><div class=\"pro-notice-body\">\u6b22\u8fce\u6765\u5230\u79d1\u6280\u5c9b\uff01\u6211\u4eec\u957f\u671f\u4e3a\u60a8\u63d0\u4f9b\u7a33\u5b9a\u3001\u5b89\u5168\u7684\u82f9\u679c ID \u4e0e\u6d77\u5916 Apple ID \u83b7\u53d6\u6307\u5357\u3002\u5728\u8fd9\u91cc\uff0c\u60a8\u53ef\u4ee5\u8f7b\u677e\u83b7\u53d6\u5b9e\u65f6\u66f4\u65b0\u7684\u5171\u4eab\u8d26\u53f7\uff0c\u5e76\u89e3\u51b3 iOS \u9501\u533a\u3001\u53cc\u91cd\u8ba4\u8bc1\uff082FA\uff09\u53ca\u8f6f\u4ef6\u4e0b\u8f7d\u7b49\u5e38\u89c1\u95ee\u9898\uff0c\u4e00\u7ad9\u5f0f\u89e3\u9501\u5168\u7403\u7cbe\u5f69\u5e94\u7528\u4e0e\u6e38\u620f\u3002</div>';\n            \n            if (headerContainer.parentNode) {\n                headerContainer.insertAdjacentElement('afterend', noticeCard);\n            }\n        }\n    }\n\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', initProTheme);\n    } else {\n        initProTheme();\n    }\n})();\n</script>", "title": "\u79d1\u6280\u5c9b - \u514d\u8d39\u82f9\u679cID\u5171\u4eab_\u7f8e\u533a\u65e5\u533aAppleID\u4e0e\u5c0f\u706b\u7bad\u8d26\u53f7\u83b7\u53d6", "subTitle": "\u6b22\u8fce\u6765\u5230\u79d1\u6280\u5c9b\uff01", "description": "\u79d1\u6280\u5c9b\u662f\u4e13\u4e1a\u76842026\u514d\u8d39\u82f9\u679cID\u5171\u4eab\u4e0e\u6d77\u5916AppleID\u83b7\u53d6\u5e73\u53f0\u3002\u6bcf\u65e5\u5b9e\u65f6\u66f4\u65b0\u7a33\u5b9a\u53ef\u7528\u7684\u7f8e\u533a\u3001\u65e5\u533a\u3001\u6e2f\u533a\u82f9\u679c\u8d26\u53f7\u53ca\u5bc6\u7801\uff0c\u4e00\u7ad9\u5f0f\u89e3\u51b3App Store\u9501\u533a\u3001\u53cc\u91cd\u8ba4\u8bc1\uff082FA\uff09\u53caShadowrocket\uff08\u5c0f\u706b\u7bad\uff09\u4e0b\u8f7d\u96be\u9898\uff0c\u5b89\u5168\u53ef\u9760\u3002", "keywords": "\u82f9\u679cID\u5171\u4eab,\u514d\u8d39\u82f9\u679cID,\u7f8e\u533aAppleID,\u65e5\u533a\u82f9\u679c\u8d26\u53f7,\u5c0f\u706b\u7bad\u5171\u4eab,appleID\u5171\u4eab,\u82f9\u679c\u5916\u533a\u8d26\u53f7,Shadowrocket\u4e0b\u8f7d,iOS\u9501\u533a\u89e3\u51b3", "avatarUrl": "https://raw.githubusercontent.com/tghaocc/tghaocc.github.io/refs/heads/main/IMG_4794.png", "GMEEK_VERSION": "last", "postListJson": {"P2": {"htmlDir": "docs/post/ping-guo-2.0.html", "labels": ["documentation"], "postTitle": "\u82f9\u679c2.0", "postUrl": "post/ping-guo-2.0.html", "postSourceUrl": "https://github.com/tghaocc/tghaocc.github.io/issues/2", "commentNum": 1, "wordCount": 3, "description": "\u82f9\u679c\ud83c\udf4e\u3002", "top": 0, "createdAt": 1790284665, "style": "", "script": "", "head": "", "ogImage": "https://raw.githubusercontent.com/tghaocc/tghaocc.github.io/refs/heads/main/IMG_4794.png", "createdDate": "2026-09-25", "dateLabelColor": "#1