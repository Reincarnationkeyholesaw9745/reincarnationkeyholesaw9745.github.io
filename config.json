;\n    padding: 0 !important;\n    opacity: 0 !important;\n    visibility: hidden !important;\n    pointer-events: none !important;\n}\n</style>\n\n<script>\n(function() {\n    if (window.__PRO_THEME_INITED__) return;\n    window.__PRO_THEME_INITED__ = true;\n\n    function initProTheme() {\n        let headerContainer = document.getElementById(\"header\") || document.querySelector(\".subnav\");\n        if (!headerContainer) return;\n\n        /* 强制隐藏副标题 DOM 元素 */\n        let subTitleElem = document.getElementById(\"subTitle\") || document.querySelector(\".subTitle\");\n        if (subTitleElem) {\n            subTitleElem.style.display = \"none\";\n        }\n\n        let searchBox = document.querySelector(\".subnav-search\") || document.querySelector(\"div[search]\");\n        if (searchBox && searchBox.parentNode !== headerContainer) {\n            headerContainer.appendChild(searchBox);\n        }\n\n        if (!document.getElementById(\"proBrandCapsule\")) {\n            let capsule = document.createElement(\"a\");\n            capsule.id = \"proBrandCapsule\";\n            capsule.href = \"https://tghaocc.github.io\";\n            capsule.className = \"pro-brand-capsule\";\n            capsule.innerHTML = '<img src=\"https://raw.githubusercontent.com/tghaocc/tghaocc.github.io/refs/heads/main/IMG_4794.png\" class=\"avatar\" alt=\"科技岛图标\"><div class=\"pro-brand-text\"><h1 class=\"pro-brand-title\">科技岛</h1><span class=\"pro-brand-subtitle\">GLOBAL STORE</span></div>';\n            \n            let oldAvatar = document.getElementById(\"avatarImg\") || document.querySelector(\".avatar\");\n            if (oldAvatar && oldAvatar.parentNode !== capsule) {\n                oldAvatar.remove();\n            }\n            headerContainer.insertBefore(capsule, headerContainer.firstChild);\n        }\n\n        if (!document.getElementById(\"proNoticeCard\")) {\n            let noticeCard = document.createElement(\"div\");\n            noticeCard.id = \"proNoticeCard